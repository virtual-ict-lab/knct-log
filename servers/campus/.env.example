SERVER_ID=campus
SECRET=
PUBLIC_URL=https://campus.knct-log.example
PEER_URL=https://knct-log.example.workers.dev
PEER_SIGNING_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# 学内サーバーが配信する PWA の設定（起動時に読む。VAPID 公開鍵は VAPID_PUBLIC_KEY を使う）
PWA_ENDPOINTS=学内=https://campus.knct-log.example,Cloudflare=https://knct-log.example.workers.dev
# パスキーの RP ID（apps/pwa/.env.example の VITE_RP_ID と同じ値）
PWA_RP_ID=knct-log.example
